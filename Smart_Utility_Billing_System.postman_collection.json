              "path": [
                "api",
                "user",
                "bills"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Unpaid"
                }
              ]
            }
          }
        },
        {
          "name": "Pay Bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMode\": \"Credit Card\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/pay/{{bill_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "pay",
                "{{bill_id}}"
              ]
            }
